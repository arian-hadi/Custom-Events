# Separate from .env.v2 (local development) and the old V1 staging .env.
# Copy to /root/Custom-Events-Staging-V2/.env.v2.staging on the server.
# Generate each value independently: python -c "import secrets; print(secrets.token_hex(32))"
STAGING_SECRET_KEY=replace-with-a-new-independent-secret-at-least-50-characters-long
STAGING_DB_PASSWORD=replace-with-a-new-hexadecimal-database-password
STAGING_DB_NAME=platform_v2_staging
STAGING_DB_USER=platform_v2_staging

# Start behind an SSH tunnel: ssh -L 8083:127.0.0.1:8083 -L 8027:127.0.0.1:8027 USER@SERVER_IP
STAGING_PUBLIC_URL=http://localhost:8083
STAGING_ALLOW_HTTP=True
STAGING_BIND_ADDRESS=127.0.0.1
STAGING_PORT=8083
STAGING_MAILPIT_PORT=8027
# With HTTPS: set the public URL, set ALLOW_HTTP=False, keep the loopback bind,
# and have your trusted host TLS proxy forward this staging site to port 8083.
# Do not expose a clone of member data on a public HTTP port.
STAGING_IMAGE_TAG=candidate
# Keep writable data and credential files outside immutable release directories.
STAGING_SECRETS_DIR=/root/Custom-Events-Staging-V2/secrets
STAGING_AUDIT_DIR=/root/Custom-Events-Staging-V2/audit

# Initial restore review starts NO workers. --profile jobs is a later explicit step.
LEAGUE_ENABLED=False
MEMBER_EMAIL_ENABLED=False
MEMBER_ACTIVITY_EMAIL_ENABLED=False
AMAZON_AUTOMATION_ENABLED=False
STRIPE_CHECKOUT_ENABLED=False
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Add staging-only provider credentials after reviewing the imported data.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
YOUTUBE_API_KEY=
LEAGUE_YOUTUBE_API_KEY=
LEAGUE_PROVIDER_CREDENTIALS_FILE=
YOUTUBE_BLOG_CREDENTIALS_FILE=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
