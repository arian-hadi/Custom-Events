{
  "name": "playo-replica",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 5173",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:league": "node --experimental-strip-types --test tests/league-view.test.mjs",
    "test:commerce": "node --experimental-strip-types --test tests/commerce.test.mjs",
    "test:dashboard": "node --experimental-strip-types --test tests/member-dashboard.test.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "replicate": "node scripts/replicate.mjs && node scripts/convert-to-next.mjs",
    "verify": "node scripts/verify-platform.mjs",
    "verify-reference": "node scripts/verify.mjs",
    "convert-reference": "node scripts/convert-to-next.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "^16.3.4",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cheerio": "^1.2.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "^8.5.28",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
