# Optional non-Docker local preview settings. Copy to .env.v2.local only if needed.
# The preview runs safely without this file and never loads prime_project/.env.
V2_LOCAL_FRONTEND_URL=http://localhost:5173
# Admin alerts are captured locally, never sent externally in this preview.
# Blank falls back to active superuser addresses; admin settings can override it.
V2_LOCAL_ADMIN_NOTIFICATION_RECIPIENTS=
V2_LOCAL_ADMIN_EMAIL_SEND_IMMEDIATELY=True
# League activation also requires a confirmed, calibrated scoring version.
# Initial fallback only. Saved Admin > League settings takes precedence.
# Optional YouTube blog discovery and owner-authorized caption credentials.
V2_LOCAL_YOUTUBE_API_KEY=
V2_LOCAL_YOUTUBE_BLOG_CREDENTIALS_FILE=
V2_LOCAL_LEAGUE_ENABLED=False
V2_LOCAL_LEAGUE_YOUTUBE_API_KEY=
# Optional private JSON file, keyed by approved application ID. Never commit it.
V2_LOCAL_LEAGUE_PROVIDER_CREDENTIALS_FILE=

# Optional Google web client credentials. Register the exact local redirect URI.
V2_LOCAL_GOOGLE_OAUTH_CLIENT_ID=
V2_LOCAL_GOOGLE_OAUTH_CLIENT_SECRET=
V2_LOCAL_GOOGLE_OAUTH_REDIRECT_URI=
# Set the preceding redirect to: http://localhost:5173/api/v2/auth/google/callback/

# Optional paired reCAPTCHA keys; leave both blank for local preview.
V2_LOCAL_RECAPTCHA_SITE_KEY=
V2_LOCAL_RECAPTCHA_SECRET_KEY=

# Normally omitted: a random key is persisted in .local-v2/django-secret.key.
# V2_LOCAL_SECRET_KEY=your-long-random-local-secret

# Member campaigns: when enabled locally, delivery still goes to .local-v2/emails.
# Choose automatic blog/shop campaigns separately in Django admin.
V2_LOCAL_MEMBER_EMAIL_ENABLED=False
V2_LOCAL_MEMBER_ACTIVITY_EMAIL_ENABLED=False
V2_LOCAL_MEMBER_EMAIL_POSTAL_ADDRESS=Local preview - captured mail only

# Stripe hosted Checkout. Use TEST keys; live payments are blocked in this preview.
# Forward Stripe CLI webhooks to http://localhost:8000/api/v2/payments/stripe/webhook/
V2_LOCAL_STRIPE_CHECKOUT_ENABLED=False
V2_LOCAL_STRIPE_SECRET_KEY=
V2_LOCAL_STRIPE_WEBHOOK_SECRET=

# Amazon Creators API. Configure ASINs in Django admin after adding credentials.
# Select the credential version/marketplace matching your approved Amazon account.
V2_LOCAL_AMAZON_AUTOMATION_ENABLED=False
V2_LOCAL_AMAZON_CREATORS_CLIENT_ID=
V2_LOCAL_AMAZON_CREATORS_CLIENT_SECRET=
V2_LOCAL_AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
V2_LOCAL_AMAZON_PARTNER_TAG=
V2_LOCAL_AMAZON_MARKETPLACE=www.amazon.com
V2_LOCAL_AMAZON_REFRESH_MINUTES=45
V2_LOCAL_AMAZON_HTTP_TIMEOUT=15
