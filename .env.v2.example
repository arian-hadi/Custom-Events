# Local Version 2 only. Copy to .env.v2. Never reuse production credentials.
SECRET_KEY=replace-with-a-long-random-local-secret
V2_DB_NAME=platform_v2
V2_DB_USER=platform_v2
V2_DB_PASSWORD=replace-with-a-random-local-database-password

# Visit this exact hostname for session/CSRF/OAuth consistency.
V2_PORT=8082
MAILPIT_PORT=8026
V2_FRONTEND_URL=http://localhost:8082
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8082

# Optional Google OAuth web application credentials. All three enable Google.
# In Google Cloud register this exact authorized redirect URI:
# http://localhost:8082/api/v2/auth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Default: capture email locally in Mailpit. To send through Gmail, set
# EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True, and your Gmail
# address/app password below. Keep EMAIL_USE_SSL=False when using port 587.
# Real SMTP applies to signup, reset, contact and enabled notification emails.
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=website@platform-v2.test
SUPPORT_EMAIL=support@platform-v2.test
# Operational admin alerts; admin settings override these recipients.
ADMIN_NOTIFICATION_RECIPIENTS=
ADMIN_NOTIFICATION_BASE_URL=http://localhost:8082
ADMIN_EMAIL_SEND_IMMEDIATELY=True
# Initial fallback only. Saved Admin > League settings takes precedence.
LEAGUE_ENABLED=False
LEAGUE_YOUTUBE_API_KEY=
# Optional: put the provider JSON in .local-v2/secrets/league-providers.json
# and set this CONTAINER path: /run/v2-secrets/league-providers.json
LEAGUE_PROVIDER_CREDENTIALS_FILE=
# Optional legacy editor-application channel verification (not ranking).
YOUTUBE_API_KEY=
# Optional owner-authorized captions for the YouTube → Blog workspace.
# Place JSON client_id/client_secret/refresh_token in .local-v2/secrets/youtube-blog.json.
# The API key alone discovers videos; script upload/paste needs no OAuth.
YOUTUBE_BLOG_CREDENTIALS_FILE=

# Background workers start with Compose in both preview and live dev modes.
# Intervals are seconds after each completed cycle. Only run one of each worker.
V2_EMAIL_INTERVAL_SECONDS=60
V2_ADMIN_EMAIL_INTERVAL_SECONDS=60
V2_AMAZON_INTERVAL_SECONDS=900
V2_LEAGUE_INTERVAL_SECONDS=60
V2_YOUTUBE_BLOG_INTERVAL_SECONDS=300
V2_JOB_TIMEOUT_SECONDS=600

# Optional reCAPTCHA: configure both keys or leave both blank for local work.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Integrations remain off until configured; workers respect the feature switches.
MEMBER_EMAIL_ENABLED=False
# Optional application decisions, league results, titles and edit status emails.
# Independent from marketing campaigns; uses MEMBER_EMAIL_BASE_URL and SMTP.
MEMBER_ACTIVITY_EMAIL_ENABLED=False
MEMBER_EMAIL_BASE_URL=http://localhost:8082
MEMBER_EMAIL_POSTAL_ADDRESS=
STRIPE_CHECKOUT_ENABLED=False
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE_PAYMENTS=False
STRIPE_CHECKOUT_BASE_URL=http://localhost:8082
AMAZON_AUTOMATION_ENABLED=False
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_REFRESH_MINUTES=45
AMAZON_HTTP_TIMEOUT=15
